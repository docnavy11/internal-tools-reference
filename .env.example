# Copy to .env for local development. Every variable is documented in docs/CONFIG.md.

NODE_ENV=development
APP_NAME=internal-tools
# In development the browser talks to the Vite dev server on 5174.
# For the built app (npm start, Docker) this is the public URL, e.g. http://localhost:3000
APP_URL=http://localhost:5174
APP_MODE=all
PORT=3000
HEALTH_PORT=3001
LOG_LEVEL=debug
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-dev-only-secret-dev-only-secret

# Postgres from docker-compose.yml (host port 5439 to avoid clashing with a local Postgres)
DATABASE_URL=postgres://app:app@localhost:5439/app
DATABASE_URL_TEST=postgres://app:app@localhost:5439/app_test
DATABASE_POOL_MAX=10
MIGRATE_ON_START=false

# Auth (phase 2). Dev login is ignored in production.
AUTH_DEV_LOGIN=true
# Comma-separated email domains that may sign in without an invitation.
AUTH_ALLOWED_DOMAINS=
AUTH_DEFAULT_ROLE=member
# Enable a provider by setting its client id and secret.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT=organizations
AUTH_MAGIC_LINK=false
SESSION_TTL_DAYS=30

# Email: console prints messages to the log. smtp arrives in phase 5.
EMAIL_DRIVER=console
EMAIL_FROM=
SMTP_URL=

# Background jobs (worker). See docs/blocks/06-jobs-and-cron.md.
JOBS_CONCURRENCY=4
JOBS_POLL_MS=1000
JOBS_RETENTION_DAYS=30
JOBS_SHUTDOWN_GRACE_MS=30000
# When set, a daily job prunes audit rows older than this. Unset keeps the log forever.
AUDIT_RETENTION_DAYS=

# Notifications. console prints to the log; smtp/bot deliver for real.
SLACK_DRIVER=console
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# File storage. disk writes under FILES_DIR; s3 works with AWS, R2 and MinIO
# (docker compose --profile s3 up -d minio, then S3_ENDPOINT=http://localhost:9000).
STORAGE_DRIVER=disk
FILES_DIR=./data/files
UPLOAD_MAX_BYTES=26214400
FILES_TRASH_DAYS=30
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Example integration (docs/blocks/07-integrations.md). Setting the key enables it.
EXAMPLE_VENDOR_API_KEY=
EXAMPLE_VENDOR_BASE_URL=https://example.invalid
EXAMPLE_VENDOR_WEBHOOK_SECRET=

# Error tracking. When set, @sentry/node must be installed (npm install @sentry/node).
SENTRY_DSN=
